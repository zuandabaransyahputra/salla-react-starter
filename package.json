{
  "name": "salla-react-starter",
  "version": "1.0.0",
  "description": "A light starter for Salla React (Twilight) themes: TanStack Start + twilight-theme-engine, RTL-first",
  "type": "module",
  "author": "Zuanda Baransyah Putra (https://zuanda.web.id)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuandabaransyahputra/salla-react-starter.git"
  },
  "homepage": "https://github.com/zuandabaransyahputra/salla-react-starter#readme",
  "bugs": {
    "url": "https://github.com/zuandabaransyahputra/salla-react-starter/issues"
  },
  "keywords": [
    "salla",
    "twilight",
    "theme",
    "react",
    "tanstack-start",
    "rtl",
    "arabic",
    "shadcn"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:manifest": "twilight-check-manifest",
    "check:locales": "node scripts/check-locales.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lighthouse": "node scripts/lighthouse.mjs",
    "qa": "node scripts/qa/qa.mjs",
    "new-theme": "node scripts/new-theme.mjs"
  },
  "dependencies": {
    "@salla.sa/twilight-components-react": "^3.0.2",
    "@salla.sa/twilight-theme-engine": "^1.0.149",
    "@tanstack/react-query": "~5.102.8",
    "@tanstack/react-router": "~1.170.38",
    "@tanstack/react-router-devtools": "~1.167.2",
    "@tanstack/react-start": "~1.168.57",
    "@tanstack/virtual-file-routes": "~1.162.0",
    "@uidotdev/usehooks": "^2.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fslightbox": "^3.8.0",
    "radix-ui": "1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@salla.sa/twilight-tailwind-theme": "^3.0.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/react-query-devtools": "~5.102.8",
    "@tanstack/router-plugin": "~1.168.40",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "~6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "esbuild": "0.28.2",
    "jsdom": "^30.0.1",
    "postcss": "8.5.26",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.103.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "private": true
}
